
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Function to check if the requesting user has the 'admin' role
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Admins can read and list all user documents.
      allow list, read: if isAdmin();
      
      // Any authenticated user can create their own user document during signup.
      allow create: if request.auth != null;

      // Only an admin or the user themselves can read or update their own document.
      allow read, update: if isAdmin() || request.auth.uid == userId;

      // Only admins can delete user documents.
      allow delete: if isAdmin();
    }

    // Rules for the 'tasks' subcollection
    match /users/{userId}/tasks/{taskId} {
      // Admins have full access to all tasks.
      // Regular users can only access their own tasks.
      allow read, write, delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // Rules for the 'settings' subcollection
    match /users/{userId}/settings/{settingId} {
      allow read, write, delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
    
    // Rules for the root 'journals' collection
    match /journals/{journalId} {
      allow list: if request.auth != null && request.auth.uid == resource.data.userId;
      allow get, update, delete: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if isAdmin() || (request.auth != null && request.auth.uid == request.resource.data.userId);
    }
  }
}
